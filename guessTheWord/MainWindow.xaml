<Window x:Class="guessTheWord.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Угадай слово" Height="520" Width="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize">
    <Grid>
        <!-- ==================== LOGIN / REGISTER PANEL ==================== -->
        <Grid x:Name="LoginPanel" Visibility="Visible">
            <Border MaxWidth="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="25" Background="#FFF8F8F8"
                    BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Угадай слово!" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>

                    <!-- === ВХОД === -->
                    <StackPanel x:Name="loginSection" Visibility="Visible">
                        <Border Background="#FFE8E8E8" Padding="10" CornerRadius="6" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Вход" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                                <Label Content="Логин:" Padding="0" Margin="0,0,0,2"/>
                                <TextBox x:Name="txtLogin" Margin="0,0,0,6" Padding="4"/>
                                <Label Content="Пароль:" Padding="0" Margin="0,0,0,2"/>
                                <PasswordBox x:Name="txtPassword" Margin="0,0,0,8" Padding="4"/>
                                <Button x:Name="btnLogin" Content="Войти"
                                        Click="BtnLogin_Click"
                                        Background="#FF90EE90" Padding="8,4" Height="32"/>
                            </StackPanel>
                        </Border>
                        <TextBlock HorizontalAlignment="Center" FontSize="12" Margin="0,0,0,8">
                            <Hyperlink Click="SwitchToRegister_Click" Foreground="#FF0066CC">
                                Нет аккаунта? Зарегистрироваться
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <!-- === РЕГИСТРАЦИЯ === -->
                    <StackPanel x:Name="registerSection" Visibility="Collapsed">
                        <Border Background="#FFE8F0FF" Padding="10" CornerRadius="6" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Регистрация" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                                <Label Content="Логин:" Padding="0" Margin="0,0,0,2"/>
                                <TextBox x:Name="txtNewLogin" Margin="0,0,0,6" Padding="4"/>
                                <Label Content="Пароль:" Padding="0" Margin="0,0,0,2"/>
                                <PasswordBox x:Name="txtNewPassword" Margin="0,0,0,6" Padding="4"/>
                                <Label Content="Повтор пароля:" Padding="0" Margin="0,0,0,2"/>
                                <PasswordBox x:Name="txtNewPasswordConfirm" Margin="0,0,0,8" Padding="4"/>
                                <Button x:Name="btnRegister" Content="Зарегистрироваться"
                                        Click="BtnRegister_Click"
                                        Background="#FF87CEFA" Padding="8,4" Height="32"/>
                            </StackPanel>
                        </Border>
                        <TextBlock HorizontalAlignment="Center" FontSize="12" Margin="0,0,0,8">
                            <Hyperlink Click="SwitchToLogin_Click" Foreground="#FF0066CC">
                                Уже есть аккаунт? Войти
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock x:Name="lblLoginMessage" TextWrapping="Wrap" TextAlignment="Center"
                               MinHeight="30" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== GAME PANEL ==================== -->
        <Grid x:Name="GamePanel" Visibility="Collapsed" Margin="20">
            <StackPanel>
                <TextBlock x:Name="lblGameTitle" Text="Угадай слово!"
                           FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <Border x:Name="borderWord" Background="#FFF5F5FF" Padding="15"
                        BorderBrush="#D0D0FF" BorderThickness="1" CornerRadius="8"
                        HorizontalAlignment="Center" MinWidth="300" Margin="0,0,0,12">
                    <TextBlock x:Name="lblWord" FontFamily="Consolas" FontSize="30"
                               FontWeight="Bold" HorizontalAlignment="Center"
                               TextAlignment="Center" Height="45"/>
                </Border>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Попыток:" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBlock x:Name="lblAttempts" FontSize="14" FontWeight="Bold"
                               Grid.Column="1" Margin="0,0,0,4"/>

                    <TextBlock Text="Буквы:" FontSize="13" VerticalAlignment="Center"
                               Grid.Row="1" Margin="0,0,8,0"/>
                    <TextBlock x:Name="lblTried" FontSize="13" Grid.Row="1" Grid.Column="1"
                               TextWrapping="Wrap"/>
                </Grid>

                <TextBlock x:Name="lblStatus" FontSize="14" FontWeight="Bold"
                           TextAlignment="Center" MinHeight="24" Margin="0,0,0,8"/>

                <Border Background="#FFF0F0F0" Padding="12" CornerRadius="6" Margin="0,0,0,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBox x:Name="txtLetter" Width="40" MaxLength="1"
                                     KeyDown="TxtLetter_KeyDown" Padding="4" Margin="0,0,4,0"/>
                            <Button x:Name="btnGuessLetter" Content="Буква" Width="75"
                                    Click="BtnGuessLetter_Click" Margin="0,0,12,0"/>
                            <TextBox x:Name="txtWordGuess" Width="160"
                                     Padding="4" Margin="0,0,4,0"/>
                            <Button x:Name="btnGuessWord" Content="Слово" Width="75"
                                    Click="BtnGuessWord_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnHint" Content="Подсказка (-1)" Width="115"
                            Click="BtnHint_Click" Margin="0,0,6,0" Padding="6,4"/>
                    <Button x:Name="btnNewGame" Content="Новая игра" Width="115"
                            Click="BtnNewGame_Click" Margin="0,0,6,0" Padding="6,4"/>
                    <Button x:Name="btnHistory" Content="История игр" Width="100"
                            Click="BtnHistory_Click" Margin="0,0,6,0" Padding="6,4"/>
                    <Button x:Name="btnLogout" Content="Выход" Width="80"
                            Click="BtnLogout_Click" Background="#FFFFB0B0" Padding="6,4"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ==================== HISTORY PANEL ==================== -->
        <Grid x:Name="HistoryPanel" Visibility="Collapsed" Margin="20">
            <StackPanel>
                <TextBlock Text="История игр" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>

                <Border Background="#FFF0FFF0" Padding="12" CornerRadius="6" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="lblStats" FontSize="14"/>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="gridHistory" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" MinHeight="200" Margin="0,0,0,10"
                          BorderBrush="#D0D0D0" BorderThickness="1"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Слово" Binding="{Binding Word}" Width="120"/>
                        <DataGridTextColumn Header="Результат" Binding="{Binding Result}" Width="100"/>
                        <DataGridTextColumn Header="Попыток" Binding="{Binding AttemptsUsed}" Width="70"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Content="Назад к игре" Width="130" HorizontalAlignment="Center"
                        Click="BtnBackToGame_Click" Padding="8,4"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
